{
  "info": {
    "_postman_id": "hiwkaw-tu-rangsit-sprint1",
    "name": "HiwKaw TU Rangsit - CS261 Sprint 1 API",
    "description": "API Test Collection for HiwKaw TU Rangsit (Canteen Open/Close Real-time Status)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. System Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "health"]
        },
        "description": "เช็คสถานะว่า Backend ทำงานปกติ"
      }
    },
    {
      "name": "1. U1 & U3 - ดึงข้อมูลร้านค้าทั้งหมด (Get All Shops)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/shops",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "shops"]
        },
        "description": "ดึงข้อมูลร้านทั้งหมด พร้อมสถานะ isOpen และเวลากลาง"
      }
    },
    {
      "name": "2. U2 - ค้นหาชื่อเมนู 'กะเพรา' (Search Dish Name)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/shops?q=กะเพรา",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "shops"],
          "query": [
            {
              "key": "q",
              "value": "กะเพรา"
            }
          ]
        },
        "description": "ค้นหาเจาะลึกเข้าไปในเมนูอาหารของแต่ละร้าน"
      }
    },
    {
      "name": "3. U2 - ฟิลเตอร์เฉพาะ 'กรีนแคนทีน' (Filter by Canteen)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/shops?canteen=green",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "shops"],
          "query": [
            {
              "key": "canteen",
              "value": "green"
            }
          ]
        },
        "description": "กรองร้านเฉพาะในโรงอาหารกรีนแคนทีน"
      }
    },
    {
      "name": "4. U3 - ข้อมูล 2 โรงอาหารและสถิติต้นทาง (Get Canteens Stats)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/canteens",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "canteens"]
        },
        "description": "ดูจำนวนร้านที่เปิด/ปิดในแต่ละโรงอาหาร"
      }
    },
    {
      "name": "5. U4 - ล็อกอินแม่ค้า (Login Vendor Phone + PIN)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.environment.set('authToken', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"0811111111\",\n  \"pin\": \"1111\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "login"]
        },
        "description": "เข้าสู่ระบบร้านป้าณี (กรีนแคนทีน) ส่งกลับ Bearer Token"
      }
    },
    {
      "name": "6. U5 - สลับสถานะเป็น 'ปิดร้าน' (Toggle Closed with Token)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isOpen\": false,\n  \"statusNote\": \"ของหมดแล้ว ปิดร้านก่อนเวลาจ้า\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/shops/shop-green-01/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "shops", "shop-green-01", "status"]
        },
        "description": "สั่งปิดร้านป้าณีผ่าน Token ที่ได้จากการ Login"
      }
    },
    {
      "name": "7. U5 - สลับสถานะกลับเป็น 'เปิดร้าน' (Toggle Open with Token)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isOpen\": true,\n  \"statusNote\": \"เปิดปกติ มีกับข้าวร้อนๆ กว่า 15 อย่าง\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/shops/shop-green-01/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "shops", "shop-green-01", "status"]
        },
        "description": "สั่งเปิดร้านป้าณีกลับสู่สถานะเดิม"
      }
    },
    {
      "name": "8. Security Test - ลองเปลี่ยนสถานะโดย 'ไม่ใส่ Token' (Expect 401)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isOpen\": false\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/shops/shop-green-01/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "shops", "shop-green-01", "status"]
        },
        "description": "ทดสอบ Security: ต้องตอบกลับ 401 Unauthorized"
      }
    }
  ]
}
